{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alcor Pro",
  "version": "0.1.0",
  "identifier": "io.alcor.pro",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Alcor Pro",
        "width": 1200,
        "height": 800,
        "minWidth": 1010,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0b0c"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "AI-native video editor for Windows",
    "longDescription": "Alcor Pro is an AI-native video editor for Windows. Edit on a multitrack timeline, generate media with your own API keys, and connect editing agents over MCP.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
